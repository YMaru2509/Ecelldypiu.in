rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if data is new (create only) and has valid timestamp
    function isNew() {
      return request.resource.data.submittedAt == request.time;
    }

    // Helper to validate basic string input to prevent massive payload attacks
    function isValidString(text, maxLength) {
      return text is string && text.size() > 0 && text.size() <= maxLength;
    }

    // 1. PUBLIC: RSVP Form
    match /rsvp_innovate_2026/{document=**} {
      allow read: if false;
      allow create: if
        isValidString(request.resource.data.name, 100) &&
        isValidString(request.resource.data.email, 100);
    }

    // 2. PUBLIC: Team Application - RELAXED RULES FOR DEBUGGING
    match /TEAM_APPLICATION_FORM/{document=**} {
      allow read: if false;
      allow create: if true; 
    }

    // 3. PUBLIC: Newsletter Subscription - RELAXED RULES FOR DEBUGGING
    match /SUBSCRIPTION_REQUESTS/{document=**} {
      allow read: if false;
      allow create: if true;
    }

    // 4. ADMIN ONLY: Events & Management
    match /events/{eventId} {
      allow read, write: if request.auth != null;
      
      match /attendees/{attendeeId} {
        allow read, write: if request.auth != null;
      }
    }

    // 5. BLOGS: Public read, admin write (via server-side API)
    match /BLOGS/{blogId} {
      allow read: if true;
      allow write: if false; // Write only via server-side Admin SDK
    }

    // 6. SHORTLINKS: Public read, server-side write only
    match /shortlinks/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // 7. MEMBERS: Member authentication & immutable joinedAt/uid/email.
    // roles/permissions/verticals (RBAC + attendance-vertical assignment) are also
    // client-immutable: they may only be set/changed server-side via the Admin SDK
    // (see api/_lib/rbac.js), never by the member themselves.
    match /members/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.get('roles', []) == []
                    && request.resource.data.get('permissions', {}) == {};
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.joinedAt == resource.data.joinedAt
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.get('roles', []) == resource.data.get('roles', [])
                    && request.resource.data.get('permissions', {}) == resource.data.get('permissions', {})
                    && request.resource.data.get('verticals', []) == resource.data.get('verticals', []);
      allow delete: if false;
    }

    // 8. RBAC + ATTENDANCE SYSTEM: fully server-mediated via the Admin SDK
    // (api/_lib/rbac.js, api/attendance*.js). No client ever reads or writes these
    // directly, matching the existing ADMIN_USERS/COLLABORATIONS/CONFIG convention.
    match /attendance_requests/{requestId} {
      allow read, write: if false;

      match /approval_history/{entryId} {
        allow read, write: if false;
      }
    }

    match /ecell_verticals/{verticalId} {
      allow read, write: if false;
    }

    match /spreadsheet_sync_jobs/{jobId} {
      allow read, write: if false;
    }

    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    match /notifications/{notificationId} {
      allow read, write: if false;
    }
  }
}
